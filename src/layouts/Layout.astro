---
// Todo apunta a Plot Center (definido como `site` en astro.config.mjs)
const siteUrl = (Astro.site ?? new URL("https://plotcenter.com.ar/")).href
const ogImage = new URL("/og-image.jpg", siteUrl).href

const title = "Vice City: La Invasión · Lanzamiento GTA VI en San Juan | Plot Center"
const description =
  "Viví el lanzamiento de GTA VI del 19 al 22 de noviembre en Libertador 580 Este, San Juan. Jugá en PS5, sorteos y premios. Entrada libre y gratuita. Organiza Plot Center."

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "Vice City: La Invasión — Lanzamiento de GTA VI",
  description,
  image: [ogImage],
  url: siteUrl,
  startDate: "2026-11-19T00:00:00-03:00",
  endDate: "2026-11-22T23:59:00-03:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "ARS",
    availability: "https://schema.org/InStock",
    url: siteUrl,
  },
  location: {
    "@type": "Place",
    name: "Plot Center",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Libertador 580 Este",
      addressLocality: "San Juan",
      addressRegion: "San Juan",
      addressCountry: "AR",
    },
  },
  organizer: {
    "@type": "Organization",
    name: "Plot Center",
    url: siteUrl,
  },
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/plot-center-logo.png" />
    <link rel="apple-touch-icon" href="/plot-center-logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Plot Center" />
    <meta name="publisher" content="Plot Center" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ff4fb4" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Plot Center" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vice City: La Invasión — 19 al 22 de noviembre en Plot Center, San Juan" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Vice City: La Invasión — 19 al 22 de noviembre en Plot Center, San Juan" />

    <!-- Datos estructurados del evento (Google) -->
    <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;0,900;1,800;1,900&family=Pacifico&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <div id="scroll-hint" class="scroll-hint">
      <span>Deslizá hacia abajo</span>
      <svg class="scroll-hint-chevron" viewBox="0 0 34 14" fill="none" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M33.5609 1.54346C34.0381 2.5875 33.6881 3.87821 32.7791 4.42633L17.0387 13.9181L1.48663 4.42115C0.580153 3.86761 0.235986 2.57483 0.717909 1.53365C1.19983 0.492464 2.32535 0.097152 3.23182 0.650692L17.0497 9.08858L31.051 0.64551C31.96 0.0973872 33.0837 0.499411 33.5609 1.54346Z"
          fill="currentColor"></path>
      </svg>
    </div>
    <script is:inline>
      const hint = document.getElementById("scroll-hint")
      if (hint) {
        const hideHint = () => {
          if (window.scrollY > 40) {
            hint.classList.add("is-gone")
            window.removeEventListener("scroll", hideHint)
          }
        }
        hideHint()
        window.addEventListener("scroll", hideHint, { passive: true })
      }
    </script>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  @theme {
    --font-sans: "GTA", system-ui, sans-serif;
    --font-narrow: "GTANarrow", system-ui, sans-serif;
    --font-display: "Montserrat", system-ui, sans-serif;
    --font-script: "Pacifico", cursive;
    --animate-bounce-pulse: bounce-pulse 2s ease-in-out infinite;
  }

  @keyframes bounce-pulse {
    0% {
      transform: translateY(0);
      scale: 0.8;
      opacity: 0.8;
    }

    50% {
      transform: translateY(-5px);
      opacity: 1;
      scale: 1;
    }

    100% {
      transform: translateY(0);
      scale: 0.8;
      opacity: 0.8;
    }
  }

  html,
  body {
    background: #111;
    overflow-x: clip;
    color: white;
    margin: 0;
    width: 100%;
    touch-action: pan-y;
  }

  .scroll-hint {
    position: fixed;
    z-index: 50;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    pointer-events: none;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
    transition: opacity 0.35s ease;
  }

  @media (min-width: 768px) {
    .scroll-hint {
      display: flex;
      bottom: 6.5rem;
    }
  }

  .scroll-hint-chevron {
    width: 1.7rem;
    height: auto;
    animation: bounce-pulse 1.4s ease-in-out infinite;
  }

  .scroll-hint.is-gone {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-chevron {
      animation: none;
    }
  }

  @font-face {
    font-family: GTA;
    src: url("/fonts/gta-regular.woff") format("woff");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: GTA;
    src: url("/fonts/gta-bold.woff") format("woff");
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: GTA;
    src: url("/fonts/gta-semibold.woff") format("woff");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: GTANarrow;
    src: url("/fonts/gta-narrow.woff") format("woff");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>
