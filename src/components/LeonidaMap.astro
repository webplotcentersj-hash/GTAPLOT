---
// Mapa de Leonida (YANIS V17). Tiles y lugares: CC BY 4.0, gtadb.org. No es un iframe.
---

<section id="mapa" class="max-w-6xl mx-auto px-5 py-14">
  <div data-reveal class="text-center mb-8">
    <p class="font-display font-bold uppercase tracking-[0.35em] text-xs text-cyan-300">
      Mapa interactivo
    </p>
    <h2
      class="mt-3 font-display font-black italic uppercase text-[clamp(2rem,6vw,3.5rem)] leading-none"
    >
      Explorá <span class="text-pink-400">el mapa</span>
    </h2>
    <p class="mt-3 text-pink-100/80 font-display text-sm md:text-base">
      El mismo mapa: arrastrá, acercá y buscá un lugar.
    </p>
  </div>

  <form class="leonida-search" role="search">
    <input
      id="leonida-query"
      type="search"
      placeholder="Buscá un lugar, por ejemplo Vice Beach"
      autocomplete="off"
      enterkeyhint="search"
    />
  </form>

  <div id="leonida-map" class="leonida-frame" role="application" aria-label="Mapa de Leonida"></div>
</section>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<style>
  .leonida-search {
    max-width: 36rem;
    margin: 0 auto 1rem;
  }
  .leonida-search input {
    width: 100%;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 79, 180, 0.55);
    background: rgba(18, 10, 36, 0.75);
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.2rem;
    outline: none;
  }
  .leonida-search input:focus {
    border-color: #ff4fb4;
    box-shadow: 0 0 16px rgba(255, 79, 180, 0.45);
  }
  .leonida-frame {
    height: min(78vh, 720px);
    border-radius: 1.25rem;
    overflow: hidden;
    border: 2px solid #ff4fb4;
    background: #2c67a4;
    box-shadow:
      0 0 18px rgba(255, 79, 180, 0.55),
      inset 0 0 18px rgba(255, 79, 180, 0.25);
    touch-action: none;
  }
  .leonida-frame .leaflet-container {
    width: 100%;
    height: 100%;
    background: #2c67a4;
    font-family: var(--font-display);
  }
  .leonida-frame .leaflet-control-attribution {
    background: rgba(18, 10, 36, 0.8);
    color: rgba(255, 255, 255, 0.7);
    font-size: 10px;
    max-width: 70%;
  }
  .leonida-frame .leaflet-control-attribution a {
    color: #ff9ed0;
  }
</style>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script is:inline>
  const root = document.getElementById("leonida-map")
  const query = document.getElementById("leonida-query")
  if (root && query && window.L) {
    const tiles =
      "https://cdn.jsdelivr.net/gh/rolux/gtadb.org@master/maps/tiles/6/yanis,17/{z}/{z},{y},{x}.jpg"
    const landmarksUrl =
      "https://cdn.jsdelivr.net/gh/rolux/gtadb.org@master/map/data/6/landmarks.json"

    const crs = Object.assign({}, L.CRS.Simple, {
      latLngToPoint(latlng, zoom) {
        const s = 2 ** zoom / 32
        return L.point((latlng.lng + 16384) * s, (16384 - latlng.lat) * s)
      },
      pointToLatLng(point, zoom) {
        const s = 2 ** zoom / 32
        return L.latLng(16384 - point.y / s, point.x / s - 16384)
      },
    })

    function start() {
      if (root.dataset.ready || root.offsetWidth === 0) return
      root.dataset.ready = "1"

      const map = L.map(root, {
        crs,
        minZoom: 0,
        maxZoom: 5,
        zoomSnap: 0.25,
        zoomDelta: 0.5,
      })
      map.setView([2700, 1500], 3)

      const ocean =
        "data:image/svg+xml," +
        encodeURIComponent(
          '<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256"><rect width="256" height="256" fill="#2c67a4"/></svg>'
        )

      L.tileLayer(tiles, {
        tileSize: 256,
        minZoom: 0,
        maxZoom: 5,
        noWrap: true,
        errorTileUrl: ocean,
        attribution:
          'Mapa YANIS V17 · <a href="https://map.gtadb.org" target="_blank" rel="noopener">gtadb.org</a> (CC BY 4.0)',
      }).addTo(map)

      const pins = []
      const canvas = L.canvas({ padding: 0.5 })

      fetch(landmarksUrl)
        .then((r) => r.json())
        .then((data) => {
          Object.values(data).forEach((row) => {
            const name = String(row[0] || "")
            const coords = row[1]
            if (!name || !coords || coords.length < 2) return
            const lng = coords[0]
            const lat = coords[1]
            pins.push({ name, lat, lng })
            L.circleMarker([lat, lng], {
              renderer: canvas,
              radius: 5,
              color: "#120a24",
              weight: 1,
              fillColor: "#ff4fb4",
              fillOpacity: 0.95,
            })
              .bindPopup("<strong>" + name.replace(/[<>&]/g, "") + "</strong>")
              .addTo(map)
          })
        })
        .catch(() => {})

      query.form.addEventListener("submit", (e) => {
        e.preventDefault()
        const q = query.value.trim().toLowerCase()
        if (!q) return
        const hit = pins.find((p) => p.name.toLowerCase().includes(q))
        if (!hit) return
        map.flyTo([hit.lat, hit.lng], 5, { duration: 0.8 })
      })
    }

    start()
    window.addEventListener("resize", start)
  }
</script>
